@using Microsoft.Extensions.Options
@using MovieApp.Models.Settings
@inject IOptions<MovieAppSettings> AppOptions
@{
var appConfig = AppOptions.Value; // injection de dépendances directement dans une vue
}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - @appConfig.NomApplication</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" 
/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp
action="Index">@appConfig.NomApplication</a>
                <environment include="Development">
                    <span class="badge bg-warning text-dark me-2">DEV</span>
                </environment>
                <button class="navbar-toggler" type="button" data-bs
toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp
controller="Home" asp-action="Index">Accueil</a></li>
                        <li class="nav-item"><a class="nav-link" asp
controller="Movies" asp-action="Index">Films</a></li>
                        <li class="nav-item"><a class="nav-link" asp
controller="Genres" asp-action="Index">Genres</a></li>
                        <li class="nav-item"><a class="nav-link" asp
controller="Home" asp-action="About">À propos</a></li>
                    </ul>
                    @* Étape 16 : <partial name="_LoginPartial" /> *@
                </div>
            </div>
        </nav>
    </header>
    <main class="container flex-grow-1 pb-4">
        @* Étape 12 : <partial name="_Alert" /> *@
        @RenderBody()
    </main>
    <footer class="border-top py-3 text-muted small">
        <div class="container">
            &copy; @DateTime.Now.Year - @appConfig.NomApplication — 
@appConfig.Slogan
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>